# ==============================================================================
# SwasthyaGrid Backend Environment Template
# Duplicate this file to .env for local/production configuration.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment (development | staging | production)
APP_NAME=SwasthyaGrid API
APP_ENV=production
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# PostgreSQL + PostGIS Database Connection URL
# For Managed Cloud Providers (Supabase, Neon, AWS RDS, Render):
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swasthyagrid
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cryptography & JWT Authentication
# Generate a cryptographically secure 64-char hex key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of authorized frontend origins (No wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://swasthyagrid.vercel.app
